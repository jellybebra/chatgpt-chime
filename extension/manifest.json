{
  "manifest_version": 3,
  "name": "ChatGPT Chime",
  "version": "1.0.5",
  "description": "A completion chime and blue dot on the ChatGPT tab icon, with adjustable volume.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "ChatGPT Chime"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}
